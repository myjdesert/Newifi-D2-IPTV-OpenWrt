# rtp2httpd —— 组播/RTSP 转 HTTP（主服务，直播与时移回看都靠它）
# 注意：段类型必须是 instance，且必须 option enabled '1'，启动脚本才会拉起进程
# 启动脚本的合法选项：enabled / listen / upstream_interface / workers /
#   maxclients / buffer_pool_max_size / udp_rcvbuf_size / mcast_rejoin_interval /
#   cors_allow_origin / status_page_path / player_page_path 等
# （port / disabled / respawn 不是合法选项，脚本不认）

config instance 'rtp2httpd'
	option enabled '1'
	option listen '0.0.0.0:5140'
	# 上游接 IPTV 专网口（PPPoE 拨号后生成的真实设备名）
	option upstream_interface 'pppoe-iptv'
	option workers '2'
	option maxclients '30'
	option buffer_pool_max_size '16384'
	option udp_rcvbuf_size '524288'
	option mcast_rejoin_interval '60'
	option cors_allow_origin '*'
	option status_page_path '/status'
	option player_page_path '/player'

	# 外部 M3U：填 gdiptv-update 生成的合并列表（直播组播 + RTSP 回看）。
	# rtp2httpd 会定时拉取它，并把列表里的 rtsp:// 回看源自动转成
	# /rtsp/<服务器:端口>/<路径> 的 HTTP 地址，于是网页播放器与
	# http://<路由IP>:5140/playlist.m3u 都能直接看回看。
	# 该值由 /usr/bin/gdiptv-update 每次生成列表后自动写入，一般不用手动改。
	option external_m3u 'http://127.0.0.1/iptv/playlist.m3u8'
	option external_m3u_update_interval '3600'
