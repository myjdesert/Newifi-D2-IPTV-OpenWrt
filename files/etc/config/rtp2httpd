config rtp2httpd
	option disabled '0'
	option respawn '1'
	option port '5140'
	# 上游接口用 netifd 逻辑名，rtp2httpd 会自行解析成 pppoe-iptv
	option upstream_interface 'iptv'
	# MT7621 双核，worker 给 2 即可；4K 频道多的话可以调到 4
	option workers '2'
	option maxclients '30'
	option buffer_pool_max_size '16384'
	option udp_rcvbuf_size '524288'
	# 部分运营商组播会静默断流，60 秒周期性重新加组更稳
	option mcast_rejoin_interval '60'
	option status_page_path '/status'
	option player_page_path '/player'
	option cors_allow_origin '*'
