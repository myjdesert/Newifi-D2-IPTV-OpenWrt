# ============================================================
# Newifi D2 IPTV 防火墙（旁路由模式）
# 注意：flow offload 会绕过组播/IPTV 的转发路径，务必保持关闭
#
# D2 此时是“主机 + IPTV 服务盒”，不是网关，因此只保留：
#   lan  区：本机对电视/手机开放服务（rtp2httpd/uhttpd/LuCI/SSH）
#   iptv 区：IPTV 专网，放行 IGMP / 组播 / 本机出访
# 不做 lan->iptv 的转发（rtp2httpd 等是本机进程，不需要转发规则）
# ============================================================

config defaults
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option synflood_protect '1'
	option flow_offloading '0'
	option flow_offloading_hw '0'

config zone
	option name 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	list network 'lan'

config zone
	option name 'iptv'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	list network 'iptv'

# ------------------------------------------------------------
# 关键：允许 LAN 下的机顶盒/播放器把流量转发进 IPTV 专网
#
# 之前这里没有 forwarding，导致 forward 链默认 drop，
# 机顶盒即便把网关指向 D2 也完全不通（表现：能拿到地址但鉴权失败、
# ping 不通 10.x / 125.88.x）。rtp2httpd/gdiptv-update 是本机进程走
# output 链不受影响，所以只在本机跑脚本时看不出问题，一接机顶盒就暴露。
# ------------------------------------------------------------
config forwarding
	option src 'lan'
	option dest 'iptv'

# ---------- IPTV 组播放行 ----------
config rule
	option name 'IPTV-Allow-IGMP'
	option src 'iptv'
	option proto 'igmp'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'IPTV-Allow-Multicast'
	option src 'iptv'
	option proto 'udp'
	option dest_ip '224.0.0.0/4'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'IPTV-Allow-LAN-Multicast'
	option src 'lan'
	option proto 'udp'
	option dest_ip '224.0.0.0/4'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'IPTV-Allow-LAN-IGMP'
	option src 'lan'
	option proto 'igmp'
	option family 'ipv4'
	option target 'ACCEPT'

# 出向 NAT 由 iptv 区的 option masq '1' 负责：
#   本机 / Bauhinia 进程访问 10.x 的 EPG、RTSP 服务器时源地址会被换成 PPPoE 地址，
#   保证回程包能原路返回。此处不要再额外加 config nat，方向写反会干扰正常的包。

config include
	option path '/etc/firewall.user'
