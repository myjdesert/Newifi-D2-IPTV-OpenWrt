# ============================================================
# Newifi D2 IPTV 防火墙
# 注意：flow offload 会绕过组播/IPTV 的转发路径，务必保持关闭
# ============================================================

config defaults
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option synflood_protect '1'
	option flow_offloading '0'
	option flow_offloading_hw '0'

config zone
	option name 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	list network 'lan'

config zone
	option name 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	list network 'wan'
	list network 'wan6'

config zone
	option name 'iptv'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	list network 'iptv'

config forwarding
	option src 'lan'
	option dest 'wan'

config forwarding
	option src 'lan'
	option dest 'iptv'

# ---------- 基础 ----------
config rule
	option name 'Allow-DHCP-Renew'
	option src 'wan'
	option proto 'udp'
	option dest_port '68'
	option target 'ACCEPT'
	option family 'ipv4'

config rule
	option name 'Allow-Ping'
	option src 'wan'
	option proto 'icmp'
	option icmp_type 'echo-request'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'Allow-IGMP'
	option src 'wan'
	option proto 'igmp'
	option family 'ipv4'
	option target 'ACCEPT'

config include
	option path '/etc/firewall.user'

# ---------- IPTV 组播放行 ----------
config rule
	option name 'IPTV-Allow-IGMP'
	option src 'iptv'
	option proto 'igmp'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'IPTV-Allow-Multicast'
	option src 'iptv'
	option proto 'udp'
	option dest_ip '224.0.0.0/4'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'IPTV-Allow-LAN-Multicast'
	option src 'lan'
	option proto 'udp'
	option dest_ip '224.0.0.0/4'
	option family 'ipv4'
	option target 'ACCEPT'

config rule
	option name 'IPTV-Allow-LAN-IGMP'
	option src 'lan'
	option proto 'igmp'
	option family 'ipv4'
	option target 'ACCEPT'

# 路由器本机访问 IPTV 平台（鉴权/频道列表/EPT RTSP）需要 NAT
config nat
	option name 'IPTV-Masq'
	option src 'iptv'
	option proto 'all'
	option target 'MASQUERADE'
