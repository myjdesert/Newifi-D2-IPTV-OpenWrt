# 备用组播转单播（rtp2httpd 出问题时用它）
# 访问 http://192.168.2.1:4022/status 看状态
# 播放地址 http://192.168.2.1:4022/udp/239.x.x.x:5140
config udpxy
	option disabled '0'
	option respawn '1'
	option verbose '0'
	option status '1'
	option port '4022'
	option bind 'br-lan'
	option source 'pppoe-iptv'
	option max_clients '20'
	option buffer_size '4096'
	option nice_increment '0'
	option log '/var/log/udpxy.log'
