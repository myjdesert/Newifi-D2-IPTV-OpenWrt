# ============================================================
# Newifi 3 D2 — 主路由上网 + 本机拨号 IPTV（旁路由串在电视与主路由之间）
#
# 物理接法（默认）：
#   WAN 口  -> 主路由 LAN 口            （上网，DHCP）
#   LAN4    -> 光猫 ITV 口              （IPTV，PPPoE 拨号）
#   LAN1-3  -> 电视机 / 机顶盒 / 其他   （br-lan，192.168.2.1/24）
#   无线     -> 默认关闭，需要时到 LuCI 启用
#
# 如果你的 IPTV 是单线复用（一根线入户+VLAN），把 iptv 的 device
# 改成 'wan.45'（45 换成你的 IPTV VLAN ID），见 README。
# ============================================================

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd8e:5c2d:9a41::/48'
	option packet_steering '1'

# br-lan 只收 LAN1-3；LAN4 给 IPTV 独占
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	option igmp_snooping '1'

config device
	option name 'br-lan'
	option ipv6 '0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.2.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

# 上联主路由
config interface 'wan'
	option device 'wan'
	option proto 'dhcp'
	option hostname 'Newifi-D2-IPTV'
	option peerdns '1'

config interface 'wan6'
	option device 'wan'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'
	option auto '0'

# ---------------- IPTV（PPPoE） ----------------
# 1) username/password 填电信给你的 IPTV 账号（常见形如 020xxxxxxxx@iptv.gd）
# 2) 若电信把 IPTV 绑定了机顶盒 MAC，取消下面 macaddr 的注释并填机顶盒 MAC
# 3) defaultroute=0：IPTV 不走默认路由，只靠 /etc/hotplug.d/iface/30-gdiptv
#    下发 183.59/125.88/59.37/202.105/10.0.0.0/8/组播 的策略路由
config interface 'iptv'
	option device 'lan4'
	option proto 'pppoe'
	option username '你的IPTV账号@iptv.gd'
	option password '你的IPTV密码'
	# option macaddr 'AA:BB:CC:DD:EE:FF'
	option defaultroute '0'
	option peerdns '1'
	option dns_metric '200'
	option delegate '0'
	option ipv6 '0'
	option metric '20'
	option keepalive '10 30'
