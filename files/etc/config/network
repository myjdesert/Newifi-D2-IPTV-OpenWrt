# ============================================================
# Newifi 3 D2 — 旁路由模式（电视机 / 手机同网段，保证投屏可用）
#
# 物理接法（默认）：
#   WAN 口  -> 光猫 ITV 口              （IPTV，PPPoE 拨号，独占）
#   LAN1-4  -> 主路由 LAN / 电视 / 手机  （桥接，192.168.1.0/24 同一网段）
#
# 说明：
#   - 本机（D2）在 192.168.1.2，主路由在 192.168.1.1；电视/手机都从主路由拿
#     192.168.1.x 的地址，彼此同网段，DLNA / Miracast / 投屏正常。
#   - D2 不做 NAT、不开 DHCP（主路由负责），只作为“IPTV 服务盒子”：
#     组播/RTSP 在 D2 上经 WAN 口的 IPTV 专网拉取，再以 HTTP 回给电视/手机。
#   - 若你的主路由网段不是 192.168.1.x，把下面的 ipaddr / gateway 改掉即可。
# ============================================================

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd8e:5c2d:9a41::/48'
	option packet_steering '1'

# br-lan 桥接 LAN1-4，接主路由 / 电视 / 手机（同一网段）
config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.2'
	option netmask '255.255.255.0'
	option gateway '192.168.1.1'
	option ip6assign '0'

# ---------------- IPTV（PPPoE，走 WAN 口） ----------------
# 1) username/password 填电信给你的 IPTV 账号（常见形如 020xxxxxxxx@iptv.gd）
# 2) 若电信把 IPTV 绑定了机顶盒 MAC，取消下面 macaddr 的注释并填机顶盒 MAC
# 3) device 默认 wan（即路由器 WAN 口）；defaultroute=0 表示 IPTV 不抢默认路由，
#    只靠 /etc/hotplug.d/iface/30-gdiptv 下发 183.59/10.0.0.0/8/组播 的策略路由
config interface 'iptv'
	option device 'wan'
	option proto 'pppoe'
	option username '你的IPTV账号@iptv.gd'
	option password '你的IPTV密码'
	# option macaddr 'AA:BB:CC:DD:EE:FF'
	option defaultroute '0'
	option peerdns '1'
	option delegate '0'
	option ipv6 '0'
	option metric '20'
	option keepalive '10 30'
