# ============================================================
# dnsmasq / DHCP
#
# 旁路由模式：D2 不开 DHCP（主路由负责），只做本地 DNS 解析 + IPTV 域名分流。
#   noresolv=1  +  server '192.168.1.1'  -> 默认上游走主路由
#   localuse=1                       -> D2 本机也用 dnsmasq 解析
#   rebind_protection=0              -> iptv.gd.cn 解析到 10.x 私网不会被当 rebinding 丢弃
#   hotplug 在 IPTV 拨号成功后追加   -> server=/iptv.gd.cn/<IPTV侧DNS>
# ============================================================

config dnsmasq
	option domainneeded '1'
	option localise_queries '1'
	option rebind_protection '0'
	option rebind_localhost '0'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option cachesize '2048'
	option authoritative '0'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option noresolv '1'
	option localuse '1'
	list server '192.168.1.1'
	option ednspacket_max '1232'
	option dnsforwardmax '1500'

# D2 不做 DHCP 服务器（主路由负责），仅保留接口声明
config dhcp 'lan'
	option interface 'lan'
	option ignore '1'

config dhcp 'iptv'
	option interface 'iptv'
	option ignore '1'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/hosts/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
